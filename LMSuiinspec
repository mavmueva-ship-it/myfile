  margin: 0;
}

.category-exam-card p {
  color: #929bad;
  font-size: 11px;
  line-height: 1.6;
  margin: 0;
}

.category-exam-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  color: #8993a5;
  font-size: 10px;
}

.exam-status {
  display: inline-flex;
  align-items: center;
  padding: 5px 9px;
  border-radius: 20px;
  background: #f0efff;
  color: #6259ce;
  font-size: 10px;
  font-weight: 700;
}

.exam-status.passed {
  background: #e5f8ee;
  color: #238451;
}

.exam-status.locked {
  background: #f0f1f5;
  color: #788195;
}

.category-exam-card .primary-button {
  width: 100%;
  margin-top: auto;
  cursor: pointer;
}

.primary-button:not(:disabled),
.secondary-button {
  cursor: pointer;
  transition: background .2s, transform .2s;
}

.primary-button:not(:disabled):hover {
  background: #5c53d0;
  transform: translateY(-1px);
}

.secondary-button {
  padding: 10px 17px;
  border: 1px solid #dfe2eb;
  border-radius: 8px;
  background: #fff;
  color: #555e72;
  font: inherit;
  font-size: 11px;
  font-weight: 700;
}

.secondary-button:hover {
  background: #f5f4ff;
}

.mock-exam-section {
  margin-top: 25px;
  padding: 20px;
  border-radius: 11px;
  background: #f7f7fc;
  border: 1px solid #eceef3;
}

.mock-exam-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.mock-exam-heading h3 {
  font-size: 14px;
  margin: 0 0 6px;
}

.mock-exam-heading p {
  color: #929bad;
  font-size: 11px;
  margin: 0;
  line-height: 1.6;
}

.mock-lock-status {
  padding: 6px 10px;
  border-radius: 20px;
  background: #efedff;
  color: #6259ce;
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
}

.mock-lock-status.unlocked {
  background: #e5f8ee;
  color: #238451;
}

.mock-exam-card {
  margin-top: 16px;
  padding: 17px;
  background: white;
  border: 1px solid #eceef3;
  border-radius: 9px;
}

.mock-exam-card p {
  color: #8993a5;
  font-size: 11px;
  line-height: 1.7;
}

.mock-exam-card .primary-button {
  cursor: pointer;
}

.activity-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid #f0f1f5;
}

.activity-item:last-child {
  border-bottom: 0;
}

.activity-item strong {
  display: block;
  font-size: 11px;
  margin-bottom: 5px;
}

.activity-item small {
  color: #929bad;
  font-size: 10px;
}

.activity-score {
  color: #6259ce;
  font-size: 12px;
  font-weight: 800;
  white-space: nowrap;
}

/* Examination workspace */

.exam-workspace,
.results-view,
.review-view {
  margin-top: 5px;
  padding: clamp(18px, 4vw, 34px);
}

.exam-workspace-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}

.exam-workspace-header h1,
.results-view h1,
.review-view h1 {
  margin: 9px 0;
  font-size: clamp(20px, 3vw, 27px);
  letter-spacing: -.5px;
}

.exam-workspace-header p,
.review-view .panel-heading p {
  margin: 0;
  color: #929bad;
  font-size: 12px;
}

.exam-timer {
  padding: 11px 15px;
  background: #efedff;
  color: #5149b5;
  border-radius: 9px;
  font-size: 17px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.exam-timer.warning {
  background: #fff0e9;
  color: #c45a31;
}

.exam-progress-track {
  width: 100%;
  height: 7px;
  border-radius: 20px;
  background: #eceef3;
  margin: 23px 0 30px;
  overflow: hidden;
}

.exam-progress-fill {
  height: 100%;
  width: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, #6259ce, #8b82ff);
  transition: width .2s;
}

.exam-question-area {
  min-height: 270px;
}

.question-number {
  color: #7067e8;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

.exam-question-area h2 {
  margin: 14px 0 22px;
  font-size: clamp(16px, 2vw, 19px);
  line-height: 1.7;
  white-space: pre-wrap;
}

.answer-options {
  display: grid;
  gap: 11px;
}

.answer-option {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 16px;
  border: 1px solid #e7e9f0;
  border-radius: 9px;
  cursor: pointer;
  transition: border .2s, background .2s;
}

.answer-option:hover {
  border-color: #8b82ff;
  background: #faf9ff;
}

.answer-option.selected {
  border-color: #7067e8;
  background: #f2f0ff;
}

.answer-option input {
  margin-top: 3px;
  accent-color: #7067e8;
}

.answer-option span {
  color: #414b60;
  font-size: 12px;
  line-height: 1.6;
}

.question-navigation {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin: 25px 0;
  padding: 17px 0;
  border-top: 1px solid #eceef3;
  border-bottom: 1px solid #eceef3;
}

.question-nav-button {
  width: 34px;
  height: 34px;
  border: 1px solid #e2e5ed;
  border-radius: 7px;
  background: white;
  color: #788195;
  font: inherit;
  font-size: 10px;
  cursor: pointer;
}

.question-nav-button.current {
  border-color: #7067e8;
  background: #7067e8;
  color: white;
}

.question-nav-button.answered {
  border-color: #b8e6cb;
  background: #e5f8ee;
  color: #238451;
}

.exam-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
}

.exam-controls > span {
  color: #929bad;
  font-size: 11px;
}

.submit-exam-button {
  background: #292e62;
  cursor: pointer;
}

/* Results */

.results-view {
  text-align: center;
  padding-top: 45px;
  padding-bottom: 45px;
}

.results-icon {
  width: 65px;
  height: 65px;
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
  border-radius: 50%;
  background: #e5f8ee;
  color: #238451;
  font-size: 30px;
}

.results-view .eyebrow {
  color: #7067e8;
}

.results-view > p {
  color: #929bad;
  font-size: 12px;
  line-height: 1.7;
}

.results-score {
  display: flex;
  justify-content: center;
  align-items: baseline;
  gap: 14px;
  margin: 25px 0;
}

.results-score strong {
  font-size: clamp(32px, 6vw, 48px);
  letter-spacing: -1.5px;
}

.results-score span {
  color: #7067e8;
  font-size: 19px;
  font-weight: 800;
}

.results-status {
  display: inline-block;
  padding: 9px 17px;
  border-radius: 30px;
  background: #fff0e9;
  color: #bd5830;
  font-size: 12px;
  font-weight: 800;
}

.results-status.passed {
  background: #e5f8ee;
  color: #238451;
}

.review-rest-message {
  max-width: 440px;
  margin: 20px auto !important;
}

.results-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 25px;
}

/* Answer review */

.review-questions {
  display: grid;
  gap: 17px;
  margin: 25px 0;
}

.review-question-card {
  padding: 19px;
  border: 1px solid #eceef3;
  border-radius: 10px;
}

.review-question-card h3 {
  margin: 0 0 13px;
  font-size: 13px;
  line-height: 1.7;
}

.review-answer-line {
  margin-top: 9px;
  font-size: 11px;
  line-height: 1.7;
}

.review-answer-line.correct {
  color: #238451;
}

.review-answer-line.incorrect {
  color: #bd5830;
}

.review-explanation {
  margin-top: 13px;
  padding: 12px;
  border-radius: 8px;
  background: #f6f6fb;
  color: #737d91;
  font-size: 11px;
  line-height: 1.7;
}

.review-view > .primary-button {
  cursor: pointer;
}

/* Responsive examination layout */

@media (max-width: 650px) {
  .category-exam-list {
    grid-template-columns: 1fr;
  }

  .mock-exam-section {
    padding: 15px;
  }

  .exam-workspace-header {
    align-items: flex-start;
  }

  .exam-timer {
    font-size: 14px;
    padding: 9px 11px;
  }

  .exam-question-area {
    min-height: 220px;
  }

  .exam-controls {
    justify-content: flex-start;
  }

  .exam-controls > span {
    order: -1;
    width: 100%;
  }

  .question-navigation {
    gap: 5px;
  }

  .question-nav-button {
    width: 30px;
    height: 30px;
  }

  .results-actions {
    flex-direction: column;
  }

  .results-actions button {
    width: 100%;
  }
}

