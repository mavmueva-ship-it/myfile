<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password | LearnSpace</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .reset-page {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
    }

    .reset-card {
      width: 100%;
      max-width: 440px;
      padding: 32px;
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 12px 40px rgba(0,0,0,.10);
    }

    .reset-card h1 { margin-top: 0; }
    .reset-card p { color: #64748b; line-height: 1.6; }
    .reset-card label {
      display: block;
      margin: 18px 0 7px;
      font-weight: 600;
    }

    .reset-card input {
      width: 100%;
      padding: 12px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      box-sizing: border-box;
    }

    .reset-card button {
      width: 100%;
      margin-top: 22px;
      padding: 13px;
      border: 0;
      border-radius: 8px;
      background: #2563eb;
      color: white;
      font-weight: 600;
      cursor: pointer;
    }

    .reset-card a { color: #2563eb; }
    #message { margin-top: 16px; }
    .error { color: #dc2626 !important; }
    .success { color: #15803d !important; }
  </style>
</head>
<body>
  <main class="reset-page">
    <section class="reset-card">
      <h1>Reset your password</h1>
      <p>Choose a new password with at least 10 characters.</p>

      <form id="resetForm">
        <label for="newPassword">New password</label>
        <input
          id="newPassword"
          type="password"
          minlength="10"
          maxlength="128"
          autocomplete="new-password"
          required
        >

        <label for="confirmPassword">Confirm new password</label>
        <input
          id="confirmPassword"
          type="password"
          minlength="10"
          maxlength="128"
          autocomplete="new-password"
          required
        >

        <button id="submitButton" type="submit">Reset password</button>
      </form>

      <p id="message" role="status" aria-live="polite"></p>
      <p><a href="/">? Back to sign in</a></p>
    </section>
  </main>

  <script>
    const form = document.getElementById('resetForm');
    const message = document.getElementById('message');
    const button = document.getElementById('submitButton');

    const token = new URLSearchParams(window.location.search).get('token') || '';

    if (!/^[a-f0-9]{64}$/i.test(token)) {
      message.textContent = 'This password-reset link is invalid or incomplete.';
      message.className = 'error';
      button.disabled = true;
    }

    form.addEventListener('submit', async event => {
      event.preventDefault();

      message.textContent = '';
      message.className = '';

      const password = document.getElementById('newPassword').value;
      const confirmation = document.getElementById('confirmPassword').value;

      if (password !== confirmation) {
        message.textContent = 'The passwords do not match.';
        message.className = 'error';
        return;
      }

      if (password.length < 10 || password.length > 128) {
        message.textContent = 'Password must be between 10 and 128 characters.';
        message.className = 'error';
        return;
      }

      button.disabled = true;
      button.textContent = 'Resetting...';

      try {
        const response = await fetch('/api/password-reset/confirm', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, password })
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || 'Unable to reset password.');
        }

        message.textContent = result.message + ' Redirecting to sign in...';
        message.className = 'success';
        form.reset();

        setTimeout(() => {
          window.location.href = '/';
        }, 1800);
      } catch (error) {
        message.textContent = error.message;
        message.className = 'error';
        button.disabled = false;
        button.textContent = 'Reset password';
      }
    });
  </script>
</body>
</html>

