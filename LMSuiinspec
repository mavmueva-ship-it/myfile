<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password | LearnSpace</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .password-page {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
    }

    .password-card {
      width: 100%;
      max-width: 440px;
      padding: 32px;
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 12px 40px rgba(0,0,0,.10);
    }

    .password-card h1 { margin-top: 0; }
    .password-card p { color: #64748b; line-height: 1.6; }
    .password-card label {
      display: block;
      margin: 18px 0 7px;
      font-weight: 600;
    }

    .password-card input {
      width: 100%;
      padding: 12px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      box-sizing: border-box;
    }

    .password-card button {
      width: 100%;
      margin-top: 22px;
      padding: 13px;
      border: 0;
      border-radius: 8px;
      background: #2563eb;
      color: white;
      font-weight: 600;
      cursor: pointer;
    }

    #message { margin-top: 16px; }
    .error { color: #dc2626 !important; }
    .success { color: #15803d !important; }
  </style>
</head>
<body>
  <main class="password-page">
    <section class="password-card">
      <h1>Change your password</h1>
      <p>
        Your account requires a new password before you can continue.
        Choose a password with at least 10 characters.
      </p>

      <form id="passwordForm">
        <label for="currentPassword">Temporary or current password</label>
        <input
          id="currentPassword"
          type="password"
          autocomplete="current-password"
          required
        >

        <label for="newPassword">New password</label>
        <input
          id="newPassword"
          type="password"
          minlength="10"
          maxlength="128"
          autocomplete="new-password"
          required
        >

        <label for="confirmPassword">Confirm new password</label>
        <input
          id="confirmPassword"
          type="password"
          minlength="10"
          maxlength="128"
          autocomplete="new-password"
          required
        >

        <button type="submit">Update password</button>
      </form>

      <p id="message" role="status" aria-live="polite"></p>
    </section>
  </main>

  <script>
    const form = document.getElementById('passwordForm');
    const message = document.getElementById('message');

    form.addEventListener('submit', async event => {
      event.preventDefault();
      message.textContent = '';
      message.className = '';

      const currentPassword =
        document.getElementById('currentPassword').value;
      const newPassword =
        document.getElementById('newPassword').value;
      const confirmPassword =
        document.getElementById('confirmPassword').value;

      if (newPassword !== confirmPassword) {
        message.textContent = 'The new passwords do not match.';
        message.className = 'error';
        return;
      }

      if (newPassword.length < 10 || newPassword.length > 128) {
        message.textContent = 'Password must be between 10 and 128 characters.';
        message.className = 'error';
        return;
      }

      try {
        const response = await fetch('/api/password/change', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword, newPassword })
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || 'Unable to change password.');
        }

        message.textContent = result.message + ' Redirecting to sign in...';
        message.className = 'success';
        form.reset();

        setTimeout(() => {
          window.location.href = '/';
        }, 1800);
      } catch (error) {
        message.textContent = error.message;
        message.className = 'error';
      }
    });
  </script>
</body>
</html>

