  <main class="recovery-page">
    <section class="recovery-card">
      <h1>Forgot your password?</h1>
      <p>
        Enter the email address associated with your LearnSpace account.
        If an account matches, recovery instructions will be provided.
      </p>

      <form id="recoveryForm">
        <label for="email">Email address</label>
        <input
          id="email"
          type="email"
          maxlength="254"
          autocomplete="email"
          placeholder="Enter your registered email"
          required
        >
        <button id="submitButton" type="submit">Request password reset</button>
      </form>

      <p id="message" role="status" aria-live="polite"></p>
      <p><a href="/">? Back to sign in</a></p>
