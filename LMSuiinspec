app.post('/api/register', async (req, res) => {
  const firstName = typeof req.body.firstName === 'string'
    ? req.body.firstName.trim()
    : '';
  const lastName = typeof req.body.lastName === 'string'
    ? req.body.lastName.trim()
    : '';
  const email = typeof req.body.email === 'string'
    ? req.body.email.trim().toLowerCase()
    : '';
  const phone = typeof req.body.phone === 'string'
    ? req.body.phone.trim()
    : '';
  const username = typeof req.body.username === 'string'
    ? req.body.username.trim()
    : '';
  const password = req.body.password;

  if (!firstName || firstName.length > 60 || !lastName || lastName.length > 60) {
    return res.status(400).json({
      error: 'First and last names are required and must not exceed 60 characters.'
    });
  }

  if (
    email.length > 254 ||
    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
  ) {
    return res.status(400).json({ error: 'Enter a valid email address.' });
  }

  if (!/^[+0-9()\-\s]{7,20}$/.test(phone)) {
    return res.status(400).json({ error: 'Enter a valid phone number.' });
  }

  if (!/^[a-zA-Z0-9_-]{3,30}$/.test(username)) {
    return res.status(400).json({
      error: 'Username must be 3â€“30 characters using letters, numbers, underscores, or hyphens.'
    });
  }

  if (typeof password !== 'string' || password.length < 10 || password.length > 128) {
    return res.status(400).json({
      error: 'Password must be between 10 and 128 characters.'
    });
  }

  try {
    const passwordHash = await auth.hashPassword(password);

    const registrationStartedAt = new Date();
    const registrationExpiresAt = new Date(
      registrationStartedAt.getTime() + 24 * 60 * 60 * 1000
    );

    const result = db.prepare(`
      INSERT INTO users
        (
          first_name, last_name, email, phone, username,
          password_hash, role, registration_started_at,
          registration_expires_at
        )
      VALUES (?, ?, ?, ?, ?, ?, 'student', ?, ?)
    `).run(
      firstName,
      lastName,
      email,
      phone,
      username,
      passwordHash,
      registrationStartedAt.toISOString(),
      registrationExpiresAt.toISOString()
    );

    res.status(201).json({
      message: 'Registration successful. Your 24-hour trial has started.',
      user: {
        id: Number(result.lastInsertRowid),
        username,
        role: 'student',
        registrationExpiresAt: registrationExpiresAt.toISOString()
      }
    });
  } catch (error) {
    if (error.code === 'SQLITE_CONSTRAINT_UNIQUE') {
      const message = error.message || '';

      if (message.includes('email')) {
        return res.status(409).json({ error: 'That email address is already registered.' });
      }

      if (message.includes('phone')) {
        return res.status(409).json({ error: 'That phone number is already registered.' });
      }

      return res.status(409).json({ error: 'That username is already taken.' });
    }

    console.error('Registration error:', error);
    res.status(500).json({ error: 'Unable to register account.' });
  }
});

app.post('/api/login', async (req, res) => {
  const username = typeof req.body.username === 'string'
    ? req.body.username.trim()
    : '';
  const password = req.body.password;

  if (!username || typeof password !== 'string') {
    return res.status(400).json({ error: 'Username and password are required.' });
  }

  try {
    const user = findUser.get(username);

    if (!user || !(await auth.verifyPassword(password, user.password_hash))) {
      return res.status(401).json({ error: 'Invalid username or password.' });
    }

    const token = auth.createSessionToken();
    const sessionId = auth.hashSessionToken(token);

    insertSession.run(sessionId, user.id, Date.now() + SESSION_DURATION);
    setSessionCookie(res, token);

    res.json({
      message: 'Login successful.',
      user: {
        id: user.id,
        username: user.username,
        role: user.role,
        mustChangePassword: Boolean(user.must_change_password)
      }
    });
  } catch (error) {
    console.error('Login error:', error);
    res.status(500).json({ error: 'Unable to log in.' });
  }
});

app.post('/api/password/change', requireAuth, async (req, res) => {
  const currentPassword = req.body.currentPassword;
  const newPassword = req.body.newPassword;

  if (
    typeof currentPassword !== 'string' ||
    typeof newPassword !== 'string'
  ) {
    return res.status(400).json({
      error: 'Current and new passwords are required.'
    });
  }

  if (newPassword.length < 10 || newPassword.length > 128) {
    return res.status(400).json({
      error: 'New password must be between 10 and 128 characters.'
    });
  }

  try {
    const user = db.prepare(
      'SELECT password_hash FROM users WHERE id = ?'
    ).get(req.user.id);

    if (!user || !(await auth.verifyPassword(currentPassword, user.password_hash))) {
      return res.status(400).json({
        error: 'Current password is incorrect.'
      });
    }

    const passwordHash = await auth.hashPassword(newPassword);
    const cookieToken = parseCookies(req.headers.cookie)[COOKIE_NAME];

    if (!cookieToken || !/^[a-f0-9]{64}$/i.test(cookieToken)) {
      return res.status(401).json({
        error: 'Please sign in again.'
      });
    }

    const currentSessionId = auth.hashSessionToken(cookieToken);

    db.exec('BEGIN IMMEDIATE');

    try {
      db.prepare(`
        UPDATE users
        SET password_hash = ?, must_change_password = 0
        WHERE id = ?
      `).run(passwordHash, req.user.id);

      db.prepare(`
        DELETE FROM sessions
        WHERE user_id = ? AND id != ?
      `).run(req.user.id, currentSessionId);

      db.prepare(`
        INSERT INTO audit_logs
          (actor_id, action, target_type, target_id, details)
        VALUES (?, 'password_changed', 'user', ?, 'Password changed by account holder.')
      `).run(req.user.id, req.user.id);

      db.exec('COMMIT');
    } catch (error) {
      db.exec('ROLLBACK');
      throw error;
    }

    return res.json({
      message: 'Password changed successfully.'
    });
  } catch (error) {
    console.error('Password change error:', error.message);
    return res.status(500).json({
      error: 'Unable to change password.'
    });
  }
});

