  });
}, async (req, res) => {
  if (!req.file) return res.status(400).json({ error: 'Choose an .xlsx workbook.' });

  const existingQuestions = db.prepare('SELECT COUNT(*) AS count FROM questions').get().count;
  if (existingQuestions > 0) {
    return res.status(409).json({ error: 'The question bank is not empty. Upload cancelled to prevent duplicate questions.' });
  }

  let tempDir;
  try {
    tempDir = await fs.promises.mkdtemp(path.join(os.tmpdir(), 'learnspace-question-upload-'));
    const workbookPath = path.join(tempDir, 'question-bank.xlsx');
    await fs.promises.writeFile(workbookPath, req.file.buffer);

    const result = await execFileAsync(process.execPath, [
      path.join(__dirname, 'import-question-bank-cse2017.js'),
      workbookPath,
      String(req.user.id)
    ], {
      cwd: __dirname,
      timeout: 180000,
      maxBuffer: 5 * 1024 * 1024
    });

    res.json({ success: true, output: result.stdout, warnings: result.stderr });
  } catch (error) {
    const details = error.stderr || error.stdout || error.message;
    res.status(422).json({
      error: 'Workbook import failed. Check the details before trying again.',
      details
    });
  } finally {
    if (tempDir) {
      await fs.promises.rm(tempDir, { recursive: true, force: true }).catch(() => {});
    }
  }
});

